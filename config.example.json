{
  "mode": "whitelist",
  "maxWhitelistTools": 0,
  "servers": [
    {
      "name": "github",
      "transport": "http",
      "url": "https://api.githubcopilot.com/mcp/",
      "tokenEnv": "GITHUB_TOKEN",
      "allowTools": []
    },
    {
      "name": "notion",
      "transport": "http",
      "url": "https://mcp.notion.com/mcp",
      "tokenEnv": "NOTION_TOKEN",
      "refreshEnv": "NOTION_REFRESH_TOKEN",
      "clientIdEnv": "NOTION_CLIENT_ID",
      "expiresInEnv": "NOTION_EXPIRES_IN",
      "allowTools": []
    },
    {
      "name": "linear",
      "transport": "http",
      "url": "https://mcp.linear.app/mcp",
      "tokenEnv": "LINEAR_TOKEN",
      "refreshEnv": "LINEAR_REFRESH_TOKEN",
      "clientIdEnv": "LINEAR_CLIENT_ID",
      "expiresInEnv": "LINEAR_EXPIRES_IN",
      "allowTools": []
    },
    {
      "name": "vercel",
      "transport": "http",
      "url": "https://mcp.vercel.com/",
      "tokenEnv": "VERCEL_TOKEN",
      "allowTools": []
    }
  ]
}

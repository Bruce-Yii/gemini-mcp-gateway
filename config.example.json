{
  "maxWhitelistTools": 20,
  "servers": [
    {
      "name": "github",
      "transport": "http",
      "url": "https://api.githubcopilot.com/mcp/readonly",
      "tokenEnv": "GITHUB_TOKEN",
      "allowTools": [
        "get_file_contents",
        "list_issues",
        "search_code",
        "search_repositories",
        "list_branches",
        "get_issue"
      ]
    },
    {
      "name": "notion",
      "transport": "http",
      "url": "https://mcp.notion.com/mcp",
      "tokenEnv": "NOTION_TOKEN",
      "allowTools": ["notion-search", "notion-fetch"]
    }
  ]
}

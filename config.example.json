{
  "mode": "whitelist",
  "maxWhitelistTools": 20,
  "servers": [
    {
      "name": "github",
      "transport": "http",
      "url": "https://api.githubcopilot.com/mcp/readonly",
      "tokenEnv": "GITHUB_TOKEN",
      "allowTools": [
        "get_file_contents",
        "list_issues",
        "search_code",
        "search_repositories",
        "list_branches",
        "get_issue"
      ]
    },
    {
      "name": "notion",
      "transport": "http",
      "url": "https://mcp.notion.com/mcp",
      "tokenEnv": "NOTION_TOKEN",
      "refreshEnv": "NOTION_REFRESH_TOKEN",
      "clientIdEnv": "NOTION_CLIENT_ID",
      "expiresInEnv": "NOTION_EXPIRES_IN",
      "allowTools": ["notion-search", "notion-fetch"]
    },
    {
      "name": "linear",
      "transport": "http",
      "url": "https://mcp.linear.app/mcp",
      "tokenEnv": "LINEAR_TOKEN",
      "refreshEnv": "LINEAR_REFRESH_TOKEN",
      "clientIdEnv": "LINEAR_CLIENT_ID",
      "expiresInEnv": "LINEAR_EXPIRES_IN",
      "allowTools": ["list_issues", "get_issue", "list_projects", "list_teams"]
    },
    {
      "name": "vercel",
      "transport": "http",
      "url": "https://mcp.vercel.com/",
      "tokenEnv": "VERCEL_TOKEN",
      "allowTools": ["list_projects", "list_deployments", "get_deployment"]
    }
  ]
}

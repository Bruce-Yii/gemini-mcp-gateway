  "_authProvisioning": {
    "_comment": "PLACEHOLDERS ONLY - no real tokens. See docs/AUTH-READY.md before asking the user to authorize.",
    "linear": {
      "preferredMode": "static_bearer",
      "tokenEnv": "LINEAR_PAT_STATIC",
      "grantOwner": "manual",
      "status": "placeholder - run scripts/auth-provision.mjs --provider linear --token-env LINEAR_PAT_STATIC --verify"
    },
    "notion": {
      "preferredMode": "static_bearer",
      "tokenEnv": "NOTION_MCP_STATIC_TOKEN",
      "grantOwner": "manual",
      "dcrPlaceholder": {
        "dcr": true,
        "registrationEndpoint": "https://mcp.notion.com/register",
        "resource": "https://mcp.notion.com/mcp",
        "clientKvKey": "gmcgw:v2:client:<env>:notion"
      },
      "status": "placeholder - static MCP token needs Business/Enterprise; DCR path implemented in upstream-oauth.js (dcr:true), still needs real authorization"
    },
    "vercel": {
      "preferredMode": "oauth",
      "clientId": "https://your-domain.example/.well-known/mcp-client.json",
      "requiredScopes": [
        "openid",
        "offline_access"
      ],
      "resource": "https://mcp.vercel.com/",
      "status": "placeholder - OAuth-only, CIMD client_id must be the public HTTPS metadata URL served by the gateway; no static token"
    }
  },

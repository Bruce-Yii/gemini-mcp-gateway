# Vercel template — env var NAMES with placeholder values only.
# Set these in the Vercel dashboard (sensitive vars) or via `vercel env add`.

PUBLIC_BASE_URL=https://<your-app>.example.invalid
ALLOWED_CLIENT_ID=gmc_REPLACE_WITH_RANDOM_HEX
ALLOWED_CLIENT_SECRET=REPLACE_WITH_RANDOM_SECRET

# Upstash Redis Marketplace vars are normally injected automatically:
# KV_REST_API_URL=https://<your-upstash-endpoint>.example.invalid
# KV_REST_API_TOKEN=REPLACE_WITH_UPSTASH_TOKEN
# (equivalently UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN)

# Upstream credentials — names must match the config's tokenEnv/refreshEnv/etc.
GITHUB_TOKEN=YOUR_GITHUB_TOKEN
EXAMPLE_TOKEN=YOUR_UPSTREAM_TOKEN
# NOTION_TOKEN=...
# NOTION_REFRESH_TOKEN=...
# NOTION_CLIENT_ID=...
# LINEAR_TOKEN=...

# Optional: inline config override (normally unset; takes precedence over GATEWAY_CONFIG)
# UPSTREAMS_JSON={"mode":"codemode","servers":[]}
# GATEWAY_CONFIG=config.example.json

# Optional: enables /upstream/oauth/start and /upstream/oauth/callback
# UPSTREAM_OAUTH_ADMIN_KEY=REPLACE_WITH_RANDOM_ADMIN_KEY

# Optional capture config (do not use the file sink on serverless)
# CAPTURE_MODE=off
# CAPTURE_SINK=r2
# R2_ACCOUNT_ID=YOUR_R2_ACCOUNT_ID
# R2_BUCKET=YOUR_BUCKET_NAME
# R2_API_TOKEN=YOUR_R2_TOKEN

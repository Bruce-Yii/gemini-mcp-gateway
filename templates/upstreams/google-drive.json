{
  "name": "google-drive",
  "transport": "http",
  "url": "https://drivemcp.googleapis.com/mcp/v1",
  "tokenEnv": "GOOGLE_DRIVE_MCP_TOKEN",
  "refreshEnv": "GOOGLE_DRIVE_REFRESH_TOKEN",
  "clientIdEnv": "GOOGLE_DRIVE_CLIENT_ID",
  "clientSecretEnv": "GOOGLE_DRIVE_CLIENT_SECRET",
  "expiresInEnv": "GOOGLE_DRIVE_EXPIRES_IN",
  "obtainedAtEnv": "GOOGLE_DRIVE_OBTAINED_AT",
  "refreshUrl": "https://oauth2.googleapis.com/token"
}

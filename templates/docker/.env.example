# Docker template — env var NAMES with placeholder values only.
# Copy to an untracked .env and fill in your own values; never commit it.

# Upstream token names (must match your mounted config)
EXAMPLE_HTTP_TOKEN=YOUR_UPSTREAM_TOKEN
# EXAMPLE_STDIO_OPTION=placeholder

# Optional result cap on the HTTP path
# GATEWAY_MAX_RESULT_CHARS=8000

# Optional capture (mount a volume at CAPTURE_FILE_DIR for durability)
# CAPTURE_MODE=off
# CAPTURE_SINK=file
# CAPTURE_FILE_DIR=/app/work/capture
# CAPTURE_HTTP_URL=https://capture.example.invalid/ingest
# CAPTURE_HTTP_TOKEN=YOUR_CAPTURE_TOKEN

# NOT honored by the CLI entry (需开发): GATEWAY_CONFIG / UPSTREAMS_JSON.
# OAuth/KV vars are used only by the Vercel HTTP entry, not this container today.

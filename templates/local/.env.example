# Local Node template — environment variable NAMES only. No real values.
# Copy to an untracked .env and fill values in your own shell/vault.

# Upstream bearer/static tokens (names must match config.local.example.json)
EXAMPLE_HTTP_TOKEN=YOUR_TOKEN_HERE
# EXAMPLE_STDIO_OPTION=placeholder

# Optional HTTP path result cap
# GATEWAY_MAX_RESULT_CHARS=8000

# Optional local capture (default: CAPTURE_MODE=off, CAPTURE_SINK=file)
# CAPTURE_MODE=off
# CAPTURE_SINK=file
# CAPTURE_FILE_DIR=./work/capture

# NOTE: GATEWAY_CONFIG / UPSTREAMS_JSON are ignored by the local CLI (需开发).
# Use: node src/server.js --config ./my-gateway.local.json --port 3000

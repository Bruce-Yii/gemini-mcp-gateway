{
  "name": "gemini-mcp-gateway",
  "version": "0.1.0",
  "description": "Code Mode MCP gateway for web-based MCP clients: three stable tools (search / execute_read / execute), sandboxed orchestration, and upstream tool payloads kept out of the model context.",
  "type": "module",
  "main": "src/server.js",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Bruce-Yii/gemini-mcp-gateway.git"
  },
  "homepage": "https://github.com/Bruce-Yii/gemini-mcp-gateway#readme",
  "bugs": {
    "url": "https://github.com/Bruce-Yii/gemini-mcp-gateway/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "code-mode",
    "gateway",
    "gemini",
    "context-engineering",
    "quickjs",
    "oauth"
  ],
  "scripts": {
    "test": "node scripts/run-tests.mjs",
    "test:watch": "node scripts/run-tests.mjs --watch",
    "verify": "npm test && node scripts/check-config.mjs && node scripts/eval-search.mjs && node scripts/measure-context.mjs",
    "start": "node src/server.js --config config.example.json --port 3000",
    "smoke": "node scripts/smoke.mjs",
    "smoke:l1": "node scripts/run-l1-smoke.mjs --mode fake",
    "smoke:l1:real": "node scripts/run-l1-smoke.mjs --mode real",
    "verify:github": "node scripts/verify-real-github.mjs",
    "check": "node --check src/server.js",
    "check:config": "node scripts/check-config.mjs",
    "bench": "node bench/run.mjs",
    "bench:dry": "node bench/run.mjs --dry-run",
    "audit:tools": "node scripts/audit-tools.mjs --server figma",
    "check:tasks": "node scripts/check-task-coverage.mjs --server figma",
    "gen:tasks": "node scripts/gen-figma-tasks.mjs"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "@cloudflare/codemode": "0.5.6",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@vercel/functions": "^3.11.3",
    "acorn": "^8.19.0",
    "run": "^2.1.13"
  }
}
